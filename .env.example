APP_ENV=development
SERVER_PORT=8080
CORS_ORIGIN=http://localhost:3000

DB_HOST=localhost
DB_PORT=5432
DB_USER=warehouse
DB_PASSWORD=change-me
DB_NAME=warehouse
DB_SSLMODE=disable
DB_SCHEMA=warehouse

# Use a unique random value of at least 32 characters outside local development.
JWT_SECRET=
OTP_TTL=5m

# Requires Tesseract and the Indonesian/English trained data on the host.
OCR_BINARY=tesseract
OCR_LANG=ind+eng
